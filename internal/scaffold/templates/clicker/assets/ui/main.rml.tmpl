<rml>
<head>
<title>{{.ProjectName}}</title>
<link type="text/rcss" href="mitiru:base.rcss"/>
<style>
  /* HUD は C++ 描画の上に重なる透明な層。pointer-events: none でクリックはゲーム側
     (in.mousePressed()) へ届く。値は C++ の hud.set("view.count", ...) が {{"{{ count }}"}} へ届ける。
     スクリプトは書かない。 */
  body { pointer-events: none; color: #ffffff; }

  .wrap { position: absolute; top: 48px; right: 0px; bottom: 0px; left: 0px;
          display: flex; flex-direction: column; align-items: center; gap: 8px; }
  .title { font-size: 20px; font-weight: bold; opacity: 0.85; }
  .count { font-size: 64px; font-weight: 900; font-effect: shadow(0px 2px #00000099); }
  .hint { position: absolute; left: 16px; bottom: 14px; font-size: 15px; opacity: 0.7;
          font-effect: shadow(0px 1px #000000b3); }
</style>
</head>
<body data-model="view">
  <div class="wrap">
    <div class="title">{{.ProjectName}}</div>
    <div class="count">{{"{{ count }}"}}</div>
  </div>

  <div class="hint">クリックで +1 (円も育つ) · ESC で終了 · この HUD はスクリプトなし (RML)</div>
</body>
</rml>
