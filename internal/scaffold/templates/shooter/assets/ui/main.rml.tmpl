<rml>
<head>
<title>{{.ProjectName}}</title>
<link type="text/rcss" href="mitiru:base.rcss"/>
<style>
  /* 場 (自機・弾・敵・ボス・星) は C++ が描く。この文書はその上に、スコア・残機・パワーアップの段階・
     ボスの体力・終わりの表示を重ねる。値は C++ の hud.set("view.score", ...) から届く。スクリプトは書かない。
     場の位置 (.field) は C++ の kFieldX / kFieldY と合わせる。半透明色は #rrggbbaa で書く。 */
  body { pointer-events: none; color: #222831; }

  .head { position: absolute; left: 430px; top: 10px; width: 420px;
          display: flex; align-items: flex-end; justify-content: space-between; }
  .title { font-size: 16px; font-weight: bold; color: #eef1f6; }
  .stats { display: flex; gap: 8px; }
  .box { background-color: #ffffff; border: 1px #dfe3ea; border-radius: 8px; padding: 4px 12px; text-align: center; }
  .label { font-size: 9px; color: #7a8290; }
  .val { font-size: 15px; font-weight: 900; margin-top: 1px; }
  .val.life { color: #e0405a; letter-spacing: 2px; }

  .power { position: absolute; left: 430px; top: 52px; width: 420px;
           display: flex; gap: 16px; justify-content: center; font-size: 11px; color: #aeb6c4; }
  .power b { color: #ff7a90; margin-left: 4px; }

  .field { position: absolute; left: 430px; top: 72px; width: 420px; height: 640px; }
  .bosshp { position: absolute; left: 8px; right: 8px; top: 8px; height: 9px; border-radius: 4px; background-color: #2a2f44; }
  .bosshp .fill { height: 100%; border-radius: 4px; background-color: #e0405a; }

  .overlay { position: absolute; top: 0px; right: 0px; bottom: 0px; left: 0px; background-color: #080b17cc;
             display: flex; align-items: center; justify-content: center; }
  .msg { font-size: 26px; font-weight: 900; text-align: center; }
  .over .msg  { color: #ff4d6a; }
  .clear .msg { color: #46e08a; }
  .sub { font-size: 14px; color: #aeb6c4; margin-top: 12px; text-align: center; }
</style>
</head>
<body data-model="view">
  <div class="head">
    <div class="title">{{.ProjectName}}</div>
    <div class="stats">
      <div class="box"><div class="label">SCORE</div><div class="val">{{"{{ score }}"}}</div></div>
      <div class="box"><div class="label">LIVES</div><div class="val life">{{"{{ lives }}"}}</div></div>
    </div>
  </div>

  <div class="power">
    <span>SPD<b>{{"{{ spd }}"}}</b></span>
    <span>RPD<b>{{"{{ rpd }}"}}</b></span>
    <span>WID<b>{{"{{ wid }}"}}</b></span>
  </div>

  <div class="field">
    <div class="bosshp" data-if="boss_active">
      <div class="fill" data-style-width="boss_pct + '%'"></div>
    </div>
    <div class="overlay over" data-if="state == 'over'">
      <div><div class="msg">GAME OVER</div><div class="sub">R でリスタート</div></div>
    </div>
    <div class="overlay clear" data-if="state == 'clear'">
      <div><div class="msg">STAGE CLEAR!</div><div class="sub">R でリスタート</div></div>
    </div>
  </div>
</body>
</rml>
