// {{.ProjectName}} — 縦スクロール・シューティング (グラディウス風)。
// ロジックは C++ (このファイル)、見た目はすべて HTML/CSS (assets/scene.html)。
//
// 敵の出現は完全にスクリプト化したタイムライン (ランダム無し＝毎回同じ)。
// パワーアップ (スピード / 連射 / 拡散) を拾って自機を強化し、最後はボス戦。
//
// `MITIRU_GAME` (Game.hpp) 経由の update(Input,Hud,float) / draw(Screen&)。
// 弾・敵・アイテムは `mitiru::Pool<T,N>` (世代付き index、取り違え防止) で管理し、
// 撃破イベントは `mitiru::MsgQueue<int,N>` で「衝突判定」と「加点」を分離する。
// HTML への entity 転送は `Hud::set(key, const char*)` に、`data-m-repeat` が読む
// 素の wire format ("field,field,...;field,...;" — engine 内部の
// `mitiru::bridge::StateWriter::list()` と同じ形) を直接組み立てて渡す
// (Hud は FrameIntents を公開しないため StateWriter 自体は使えない)。

#include <mitiru/module/Game.hpp>
#include <mitiru/module/AutoReflect.hpp>
#include <mitiru/module/PodPool.hpp>
#include <mitiru/module/PodQueue.hpp>

#include <cmath>
#include <cstdio>
#include <cstring>

using namespace mitiru;

namespace
{

constexpr float kFieldW = 420.0f;
constexpr float kFieldH = 640.0f;

constexpr int kMaxBullets  = 64;
constexpr int kMaxEnemies  = 40;
constexpr int kMaxEBullets = 64;
constexpr int kMaxPowerups = 8;

constexpr float kBulletSpd = 780.0f;
constexpr float kBossTime  = 28.0f;   // この秒数でボスが出る (タイムライン終端)
constexpr int   kBossHp    = 150;

// 敵種別:   0=直進  1=ウェーブ  2=ダイバー(自機へ寄る)  3=キャリア(倒すとアイテム)
// アイテム: 0=スピード  1=連射  2=拡散

struct Bullet  { float x = 0, y = 0, vx = 0, vy = 0; };
struct Enemy   { float x = 0, y = 0, x0 = 0, age = 0; int kind = 0; int hp = 0; };
struct Powerup { float x = 0, y = 0; int kind = 0; };
struct Boss    { float x = 0, y = 0, age = 0; int hp = 0; bool active = false; bool entering = false; float fireCd = 0; };

// ── 出現スケジュール (完全固定。time 秒に kind の敵を count 体、form 配置で出す) ──
// form: 0=横一列  1=左から斜め  2=右から斜め  3=param の x に単体
struct Wave { float time; int kind; int count; int form; float param; };
constexpr Wave kWaves[] = {
    { 1.5f, 0, 4, 0,   0 },
    { 3.5f, 1, 3, 0,   0 },
    { 5.0f, 3, 1, 3, 210 },   // キャリア (アイテム)
    { 5.5f, 0, 3, 1,   0 },
    { 8.0f, 1, 4, 0,   0 },
    {10.0f, 2, 3, 0,   0 },   // ダイバー
    {12.0f, 3, 1, 3, 120 },
    {12.6f, 0, 5, 2,   0 },
    {15.0f, 2, 4, 0,   0 },
    {17.0f, 1, 5, 0,   0 },
    {19.0f, 3, 1, 3, 300 },
    {19.6f, 0, 6, 0,   0 },
    {22.0f, 2, 5, 0,   0 },
    {24.5f, 1, 6, 0,   0 },
};
constexpr int kNumWaves = (int)(sizeof(kWaves) / sizeof(kWaves[0]));

// ── 小物 ────────────────────────────────────────────────────────────────
float clampf(float v, float lo, float hi) { return v < lo ? lo : (v > hi ? hi : v); }
int   ri(float v) { return (int)std::lround(v); }   // compact 列用に丸め
int   hpFor(int kind)    { return kind == 2 ? 2 : 1; }
int   scoreFor(int kind) { static const int s[4] = {10, 15, 25, 30}; return s[kind & 3]; }

// ── 表示用ヘルパー (整形は C++ 側。HTML は値を出すだけ) ──────────────────────
void appendPips(char* out, std::size_t cap, int lv, int max)   // ●●○ のピップ
{
    std::size_t pos = 0;
    for (int i = 0; i < max && pos + 3 < cap; ++i)
    {
        const char* glyph = (i < lv) ? "\xE2\x97\x8F" : "\xE2\x97\x8B";   // ●/○ (UTF-8)
        std::memcpy(out + pos, glyph, 3);
        pos += 3;
    }
    out[pos] = '\0';
}
void appendLives(char* out, std::size_t cap, int n)
{
    std::size_t pos = 0;
    for (int i = 0; i < n && pos + 3 < cap; ++i) { std::memcpy(out + pos, "\xE2\x96\xB2", 3); pos += 3; }   // ▲
    out[pos] = '\0';
}

// ── entity wire builder ───────────────────────────────────────────────────
// `data-m-repeat="view.scene" data-m-fields="t,x,y,v" data-m-type="t"` (assets/scene.html)
// が読む素の行形式 "t,x,y,v;t,x,y,v;..." をここで直接組み立てる。engine 内部の
// StateWriter::list() と同じ wire だが、Hud は FrameIntents を公開しないため
// 文字列として自前で組む。統計値 (score 等) は個別に Hud::set するので十分小さく、
// ここは「多数」のエンティティだけをまとめて 1 statePush にする経路。
class SceneList
{
public:
    void row(int t, int x, int y, int v)
    {
        if (m_pos >= sizeof(m_buf) - 32) { return; }   // 3968B の statePush 上限に対する安全マージン
        const int n = std::snprintf(m_buf + m_pos, sizeof(m_buf) - m_pos, "%d,%d,%d,%d;", t, x, y, v);
        if (n > 0) { m_pos += static_cast<std::size_t>(n); }
    }
    const char* c_str() const { return m_buf; }

private:
    char        m_buf[4096] = {};
    std::size_t m_pos       = 0;
};

}  // namespace

struct {{.ProjectIdent}}Game
{
    float px = kFieldW * 0.5f;
    float py = kFieldH - 70.0f;
    int   speedLv = 0, rapidLv = 0, spreadLv = 0;   // パワーアップ段階
    float fireCd  = 0;
    float invuln  = 0;       // 被弾後の無敵時間 (>0 の間は当たらない)
    int   lives   = 3;
    int   score   = 0;
    float elapsed  = 0;      // タイムライン時計
    int   waveIdx  = 0;      // 次に出すウェーブ
    int   dropCycle = 0;     // キャリアが落とすアイテム種別の循環
    int   tick = 0;
    // bool 3 つをまとめて置く (AutoReflect の padding 警告対策。バラバラだと
    // float/int の 4 byte alignment で隙間が空く)。
    bool  gameOver = false;
    bool  won      = false;
    bool  bossSpawned = false;
    Boss  boss;

    Pool<Bullet, kMaxBullets>   bullets;
    Pool<Enemy, kMaxEnemies>    enemies;
    Pool<Bullet, kMaxEBullets>  ebullets;   // 敵弾 (ボスが撃つ)
    Pool<Powerup, kMaxPowerups> powerups;

    // 撃破 (enemy kind) を衝突判定から加点処理へ渡す。判定と加点を分けておくと、
    // 後でコンボ / 演出をここに差し込んでも collide() 側を触らずに済む。
    MsgQueue<int, kMaxEnemies> killQueue;

    void update(Input in, Hud hud, float dt)
    {
        ++tick;
        if (in.pressed(Key::Escape)) { hud.quit(); }
        if (in.pressed(Key::R))      { *this = {{.ProjectIdent}}Game{}; }   // リスタート

        if (!gameOver && !won)
        {
            updateTimeline(dt);
            updatePlayer(dt, in);
            updateEnemies(dt);
            updateBoss(dt);
            updateMovers(dt);
            collide();
            applyKillQueue();
        }

        pushScene(hud);
        if (tick % 4 == 0) { pushStats(hud); }
    }

    void draw(Screen& s)
    {
        s.fillScreen(hex(0x0B0E17));   // 背後の宇宙色 (見た目は HTML)
    }

private:
    // ── 自機 ────────────────────────────────────────────────────────────
    float playerSpeed() const { return 240.0f + speedLv * 55.0f; }
    float fireInterval() const { return std::fmax(0.06f, 0.20f - rapidLv * 0.045f); }

    void fireShot()
    {
        const int n = (spreadLv == 0) ? 1 : (spreadLv == 1 ? 3 : 5);
        static const float a1[] = {0.0f};
        static const float a3[] = {-0.20f, 0.0f, 0.20f};
        static const float a5[] = {-0.38f, -0.19f, 0.0f, 0.19f, 0.38f};
        const float* a = (n == 1) ? a1 : (n == 3 ? a3 : a5);
        for (int i = 0; i < n; ++i)
        {
            if (Ref r = bullets.alloc(); !r.isNull())
            {
                if (Bullet* b = bullets.get(r))
                {
                    *b = {px, py - 16.0f, std::sin(a[i]) * kBulletSpd, -std::cos(a[i]) * kBulletSpd};
                }
            }
        }
    }

    void updatePlayer(float dt, Input in)
    {
        const float spd = playerSpeed();
        if (in.down(Key::Left))  { px -= spd * dt; }
        if (in.down(Key::Right)) { px += spd * dt; }
        if (in.down(Key::Up))    { py -= spd * dt; }
        if (in.down(Key::Down))  { py += spd * dt; }
        px = clampf(px, 16.0f, kFieldW - 16.0f);
        py = clampf(py, 40.0f, kFieldH - 30.0f);

        fireCd -= dt;
        if (in.down(Key::Space) && fireCd <= 0.0f) { fireShot(); fireCd = fireInterval(); }
        if (invuln > 0.0f) { invuln -= dt; }
    }

    // ── 敵の移動 ─────────────────────────────────────────────────────────
    void updateEnemies(float dt)
    {
        enemies.forEachAlive([&](Enemy& e, Ref)
        {
            e.age += dt;
            switch (e.kind)
            {
            case 1:  e.y += 95.0f * dt;  e.x = e.x0 + std::sin(e.age * 3.2f) * 70.0f; break;   // ウェーブ
            case 2:  e.y += 135.0f * dt; e.x += clampf(px - e.x, -75.0f * dt, 75.0f * dt); break;   // ダイバー
            case 3:  e.y += 70.0f * dt;  break;                                                // キャリア (遅い)
            default: e.y += 115.0f * dt; break;                                                // 直進
            }
            e.x = clampf(e.x, 8.0f, kFieldW - 8.0f);
        });
        enemies.forEachAlive([&](Enemy& e, Ref r) { if (e.y > kFieldH + 30.0f) { enemies.free(r); } });   // 下抜け (ペナルティ無し)
    }

    void updateMovers(float dt)
    {
        bullets.forEachAlive([&](Bullet& b, Ref) { b.x += b.vx * dt; b.y += b.vy * dt; });
        bullets.forEachAlive([&](Bullet& b, Ref r)
        {
            if (b.y < -16 || b.x < -16 || b.x > kFieldW + 16) { bullets.free(r); }
        });
        ebullets.forEachAlive([&](Bullet& b, Ref) { b.x += b.vx * dt; b.y += b.vy * dt; });
        ebullets.forEachAlive([&](Bullet& b, Ref r)
        {
            if (b.y > kFieldH + 16 || b.y < -16 || b.x < -16 || b.x > kFieldW + 16) { ebullets.free(r); }
        });
        powerups.forEachAlive([&](Powerup& p, Ref) { p.y += 85.0f; /* px/frame は下で dt 反映 */ });
        powerups.forEachAlive([&](Powerup& p, Ref r) { if (p.y > kFieldH + 20) { powerups.free(r); } });
        (void)dt;
    }

    // ── ボス ────────────────────────────────────────────────────────────
    void updateBoss(float dt)
    {
        if (!boss.active) { return; }
        if (boss.entering)
        {
            boss.y += 80.0f * dt;
            if (boss.y >= 95.0f) { boss.y = 95.0f; boss.entering = false; }
            return;
        }
        boss.age += dt;
        boss.x = kFieldW * 0.5f + std::sin(boss.age * 0.9f) * 125.0f;
        boss.fireCd -= dt;
        if (boss.fireCd <= 0.0f)
        {
            const float base = std::atan2(py - boss.y, px - boss.x);   // 自機方向へ 3-way
            for (float k : {-0.28f, 0.0f, 0.28f})
            {
                if (Ref r = ebullets.alloc(); !r.isNull())
                {
                    if (Bullet* b = ebullets.get(r))
                    {
                        *b = {boss.x, boss.y + 30.0f, std::cos(base + k) * 235.0f, std::sin(base + k) * 235.0f};
                    }
                }
            }
            boss.fireCd = 0.95f;
        }
    }

    // ── タイムライン進行 ──────────────────────────────────────────────────
    void spawnWave(const Wave& w)
    {
        for (int i = 0; i < w.count; ++i)
        {
            float x, y;
            switch (w.form)
            {
            case 1:  x = 40.0f + i * 64.0f;            y = -20.0f - i * 42.0f; break;   // 左斜め
            case 2:  x = kFieldW - 40.0f - i * 64.0f;  y = -20.0f - i * 42.0f; break;   // 右斜め
            case 3:  x = w.param;                       y = -20.0f;             break;   // 単体
            default: x = w.count == 1 ? kFieldW * 0.5f
                           : 40.0f + (kFieldW - 80.0f) * ((float)i / (w.count - 1));
                     y = -20.0f - (i % 2) * 16.0f;      break;                           // 横一列
            }
            if (Ref r = enemies.alloc(); !r.isNull())
            {
                if (Enemy* e = enemies.get(r))
                {
                    const float ex = clampf(x, 16.0f, kFieldW - 16.0f);
                    *e = {ex, y, ex, 0.0f, w.kind, hpFor(w.kind)};
                }
            }
        }
    }

    void updateTimeline(float dt)
    {
        elapsed += dt;
        while (waveIdx < kNumWaves && kWaves[waveIdx].time <= elapsed) { spawnWave(kWaves[waveIdx]); ++waveIdx; }
        if (!bossSpawned && elapsed >= kBossTime)
        {
            boss = {kFieldW * 0.5f, -60.0f, 0.0f, kBossHp, true, true, 1.2f};
            bossSpawned = true;
        }
    }

    // ── 被弾 / 取得 ───────────────────────────────────────────────────────
    void hitPlayer()
    {
        if (invuln > 0.0f) { return; }
        invuln = 1.4f;
        if (--lives <= 0) { lives = 0; gameOver = true; }
    }
    void applyPowerup(int kind)
    {
        if (kind == 0)      { speedLv  = speedLv  < 3 ? speedLv + 1  : 3; }
        else if (kind == 1) { rapidLv  = rapidLv  < 3 ? rapidLv + 1  : 3; }
        else                { spreadLv = spreadLv < 2 ? spreadLv + 1 : 2; }
    }

    void applyKillQueue()
    {
        killQueue.drain([&](const int& kind) { score += scoreFor(kind); });
    }

    void collide()
    {
        // 自弾 × 敵
        enemies.forEachAlive([&](Enemy& e, Ref er)
        {
            bullets.forEachAlive([&](Bullet& b, Ref br)
            {
                if (std::fabs(b.x - e.x) < 18.0f && std::fabs(b.y - e.y) < 20.0f)
                {
                    bullets.free(br);
                    if (--e.hp <= 0)
                    {
                        (void)killQueue.push(e.kind);
                        if (e.kind == 3)
                        {
                            if (Ref pr = powerups.alloc(); !pr.isNull())
                            {
                                if (Powerup* p = powerups.get(pr)) { *p = {e.x, e.y, dropCycle % 3}; }
                                ++dropCycle;
                            }
                        }
                        enemies.free(er);
                    }
                }
            });
        });
        // 自弾 × ボス
        if (boss.active && !boss.entering)
        {
            bullets.forEachAlive([&](Bullet& b, Ref br)
            {
                if (std::fabs(b.x - boss.x) < 46.0f && std::fabs(b.y - boss.y) < 32.0f)
                {
                    bullets.free(br);
                    if (--boss.hp <= 0) { boss.active = false; won = true; }
                }
            });
        }
        // 敵 / 敵弾 / ボス × 自機
        enemies.forEachAlive([&](Enemy& e, Ref er)
        {
            if (std::fabs(e.x - px) < 24.0f && std::fabs(e.y - py) < 24.0f) { enemies.free(er); hitPlayer(); }
        });
        ebullets.forEachAlive([&](Bullet& b, Ref br)
        {
            if (std::fabs(b.x - px) < 14.0f && std::fabs(b.y - py) < 16.0f) { ebullets.free(br); hitPlayer(); }
        });
        if (boss.active && std::fabs(boss.x - px) < 46.0f && std::fabs(boss.y - py) < 34.0f) { hitPlayer(); }
        // アイテム × 自機
        powerups.forEachAlive([&](Powerup& p, Ref pr)
        {
            if (std::fabs(p.x - px) < 24.0f && std::fabs(p.y - py) < 24.0f) { applyPowerup(p.kind); powerups.free(pr); }
        });
    }

    // ── HTML への push ───────────────────────────────────────────────────
    void pushScene(Hud& hud)
    {
        SceneList list;
        list.row(0, ri(px), ri(py), invuln > 0.0f ? 1 : 0);
        bullets.forEachAlive([&](const Bullet& b, Ref)  { list.row(1, ri(b.x), ri(b.y), 0); });
        enemies.forEachAlive([&](const Enemy& e, Ref)   { list.row(2, ri(e.x), ri(e.y), e.kind); });
        ebullets.forEachAlive([&](const Bullet& b, Ref) { list.row(3, ri(b.x), ri(b.y), 0); });
        powerups.forEachAlive([&](const Powerup& p, Ref){ list.row(4, ri(p.x), ri(p.y), p.kind); });
        if (boss.active) { list.row(5, ri(boss.x), ri(boss.y), 0); }
        hud.set("view.scene", list.c_str());
    }

    void pushStats(Hud& hud)
    {
        char buf[32];
        hud.set("view.score", score);
        appendLives(buf, sizeof(buf), lives);        hud.set("view.lives", buf);
        appendPips(buf, sizeof(buf), speedLv, 3);     hud.set("view.spd", buf);
        appendPips(buf, sizeof(buf), rapidLv, 3);     hud.set("view.rpd", buf);
        appendPips(buf, sizeof(buf), spreadLv, 2);    hud.set("view.wid", buf);
        hud.set("view.boss.active", boss.active);
        hud.set("view.boss.pct", boss.active ? boss.hp * 100 / kBossHp : 0);
        hud.set("view.state", won ? "clear" : (gameOver ? "over" : ""));
    }
};

// GameMemory (この構造体自身) を巻き戻し・観測 inspector に自動反射する。
// Pool<T,N> は要素ごとに展開されるため、この規模 (bullets/enemies/ebullets/powerups
// 合計 176 要素) では ModuleApi の反射フィールド上限を超え、超過分は黙って切り捨てられる
// (host が起動時に 1 回 warnOnce する。巻き戻し自体は GameMemory の生バイト列を使うため
// 影響しない — 削られるのは Inspector 表示の一部だけ)。
MITIRU_REFLECT_AUTO({{.ProjectIdent}}Game);

MITIRU_GAME({{.ProjectIdent}}Game);
